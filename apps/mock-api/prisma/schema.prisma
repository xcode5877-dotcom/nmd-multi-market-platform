generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id                  String  @id
  name                String
  slug                String  @unique
  imageUrl            String? // market card/hero image; persisted so admin banner update survives rebuild
  branding            String? // JSON
  isActive            Boolean @default(true)
  sortOrder           Int?
  paymentCapabilities String? // JSON { cash, card }
  paymentMethods     String? // JSON { cash, card, installments }
}

model Tenant {
  id                         String   @id
  slug                       String   @unique
  name                       String
  logoUrl                    String
  primaryColor               String
  secondaryColor             String
  fontFamily                 String
  radiusScale                Float
  layoutStyle                String
  enabled                    Boolean  @default(true)
  createdAt                  String
  templateId                 String?
  hero                       String? // JSON
  banners                    String? // JSON
  whatsappPhone              String?
  type                       String?
  businessType               String?  @default("RETAIL") // RETAIL | RESTAURANT | SERVICE (multi-sector)
  marketCategory             String?
  marketId                   String?
  isListedInMarket           Boolean?
  marketSortOrder            Int?
  tenantType                 String?
  deliveryProviderMode       String?
  allowMarketCourierFallback Boolean?
  defaultPrepTimeMin         Int?
  financialConfig            String? // JSON
  paymentCapabilities        String? // JSON
  paymentMethods             String? // JSON { cash, card, installments }
  // Merchant Settings (Store Settings page)
  operationalStatus          String? // open | closed | busy
  orderPolicy                String? // accept_always | accept_only_when_open
  businessHours              String? // JSON: BusinessHours per-day
  busyBannerEnabled          Boolean?
  busyBannerText             String?
  bookingEnabled             Boolean?
  about                      String?
  officeHours                String?
  openTime                   String? // HH:mm daily open (e.g. 08:00)
  closeTime                  String? // HH:mm daily close (e.g. 17:00)
  forceClosed                Boolean? @default(false) // manual override: always show closed
  overrideStatus             String? // AUTO (default/null) | FORCE_OPEN | FORCE_CLOSED — super-admin remote override
  phone                      String?
  storeType                  String? // RESTAURANT | PROFESSIONAL
  appointmentDuration        Int?
  collections                String? // JSON: HomeCollection[] (admin homepage sections)
  addressLine                String?
  location                   String? // JSON: { lat, lng }
  deliveryRadiusKm           Float? // max delivery distance from store (km); used when no zone matches
  meta                       String? // JSON: _meta from import (e.g. emergencyReason)
  pillarId                   String? // pillar (category) for market section filtering (e.g. Restaurants, Services)
  subCategoryId              String? // sub-category under pillar
}

model User {
  id                 String         @id
  email              String         @unique
  role               String
  marketId           String?
  tenantId           String?
  courierId          String?
  password           String?
  mustChangePassword Boolean?       @default(false)
  fcmToken           String? // Legacy: single token; prefer UserFCMToken for multi-device (Global Identity: tokens keyed by userId)
  fcmTokens          UserFCMToken[]
}

// Global Identity: FCM tokens are linked to userId regardless of store. One user can have multiple devices.
model UserFCMToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model Courier {
  id              String   @id
  scopeType       String
  scopeId         String
  marketId        String?
  name            String
  phone           String?
  password        String?
  allowedStoreIds String? // JSON array of tenant/store ids allowed for external manual orders
  isActive        Boolean  @default(true)
  isOnline        Boolean  @default(false)
  capacity        Int      @default(1)
  isAvailable     Boolean?
  deliveryCount   Int?
}

model Customer {
  id                String             @id
  phone             String             @unique
  name              String?
  email             String?
  city              String?
  avatarUrl         String?
  /// JSON: addresses, paymentMethods, notification prefs (see customer-account-extras in mock-api).
  accountExtras     Json?
  createdAt         String
  fcmTokens         CustomerFCMToken[]
  rewardRedemptions RewardRedemption[]
}

// FCM tokens for customer push (Android app). One row per device; link by customerId.
model CustomerFCMToken {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Order {
  id                  String   @id
  tenantId            String?
  courierId           String?
  marketId            String?
  status              String?
  fulfillmentType     String?
  orderType           String?  @default("PRODUCT") // PRODUCT | FOOD | SERVICE | EXTERNAL (multi-sector)
  total               Float?
  createdAt           String?
  payment             String? // JSON (kept for response shape; Payment table is source of truth for finance)
  deliveryTimeline    String? // JSON
  payload             String? // JSON: items, delivery, customerName, etc.
  isExternal          Boolean  @default(false) // manual driver-entered delivery (off-app)
  externalDestination String? // city / village label
  manualStoreName     String? // free-text store name when no tenant/store was selected
  paymentRecord       Payment?
}

/// Per-courier payroll configuration (Phase 1 — tracking only).
model CourierPayrollConfig {
  courierId               String  @id
  hourlyRate              Float   @default(35)
  deliveryFeeShare        Float   @default(100) // percent of delivery fee credited to driver
  orderCommissionPercent  Float   @default(5)
  isPayrollEnabled        Boolean @default(true)
  updatedAt               String
}

/// Driver shift tracking (start/end duty).
model CourierShift {
  id              String  @id
  courierId       String
  marketId        String
  startTime       String
  endTime         String?
  durationMinutes Int?
  autoClosed      Boolean @default(false)
  createdAt       String

  @@index([courierId])
  @@index([courierId, startTime])
}

/// Store-wide driver commission override (all couriers for tenant).
model TenantDriverCommissionOverride {
  tenantId               String @id
  orderCommissionPercent Float
  updatedAt              String
}

/// Per-courier commission override for a specific store.
model CourierTenantCommissionOverride {
  tenantId               String
  courierId              String
  orderCommissionPercent Float
  updatedAt              String

  @@id([tenantId, courierId])
  @@index([courierId])
}

/// Append-only driver earnings ledger (Phase 1 — no payouts).
model CourierEarningsLedger {
  id          String  @id
  courierId   String
  marketId    String?
  type        String // DELIVERY_FEE | ORDER_COMMISSION | HOURLY_PAY | BONUS | EXPENSE | ADJUSTMENT
  amount      Float
  referenceId String?
  description String?
  createdAt   String

  @@index([courierId, createdAt])
  @@index([courierId, type])
  @@index([referenceId, type])
}

/// Driver expense submissions (courier → admin approval).
model CourierExpense {
  id        String  @id
  courierId String
  marketId  String
  category  String // FUEL | REPAIR | CAR_WASH | PARKING | OTHER
  amount    Float
  currency  String  @default("ILS")
  note      String?
  status    String  @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt String
  reviewedAt String?
  reviewedBy String?

  @@index([courierId])
  @@index([marketId])
  @@index([createdAt])
  @@index([status])
}

/// Frozen payroll settlement for a driver period (Phase 2).
model CourierPayrollSettlement {
  id             String  @id
  courierId      String
  marketId       String?
  periodStart    String
  periodEnd      String
  grossAmount    Float
  expensesAmount Float
  netAmount      Float
  notes          String?
  snapshot       String? // JSON breakdown: hoursWorked, hourlyPay, deliveryEarnings, etc.
  createdBy      String?
  createdAt      String

  @@index([courierId])
  @@index([courierId, periodStart, periodEnd])
  @@index([createdAt])
  @@index([marketId])
}

/// Append-only driver payroll audit trail.
model DriverPayrollAudit {
  id        String  @id
  courierId String?
  userId    String?
  action    String // SHIFT_STARTED | SHIFT_ENDED | BONUS_ADDED | EXPENSE_APPROVED | EXPENSE_REJECTED
  metadata  String? // JSON
  createdAt String

  @@index([courierId])
  @@index([createdAt])
}

// --- Payments (cash-first, card-ready; no gateway integration yet) ---
model Payment {
  id          String  @id
  orderId     String  @unique
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      String // CASH | CARD
  status      String // PENDING | COLLECTED | AUTHORIZED | CAPTURED | REFUNDED
  amount      Float
  currency    String  @default("ILS")
  provider    String? // future: stripe, tap, etc.
  providerRef String? // future: gateway transaction id
  createdAt   String
  updatedAt   String

  @@index([orderId])
}

// --- Catalog (tenant-scoped) ---
model CatalogCategory {
  id          String   @id
  tenantId    String
  name        String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int
  parentId    String?
  isVisible   Boolean? @default(true)
  markupExempt Boolean @default(false)

  @@index([tenantId])
}

/// Append-only store settlement ledger (pickup debt, payments, delivery/online revenue).
model StoreSettlementLedgerEntry {
  id         String  @id
  tenantId   String
  marketId   String?
  orderId    String?
  entryType  String
  direction  String // DEBIT | CREDIT
  amount     Float
  currency   String  @default("ILS")
  occurredAt String
  createdAt  String
  createdBy  String?
  note       String?
  metadata   String? // JSON

  @@index([tenantId, occurredAt])
  @@index([orderId])
}

/// Manual settlement payments between store and Now Market platform.
model StoreSettlementPayment {
  id            String  @id
  tenantId      String
  amount        Float
  paidAt        String
  paymentMethod String
  note          String?
  createdBy     String?
  direction     String // STORE_TO_PLATFORM | PLATFORM_TO_STORE
  periodFrom    String?
  periodTo      String?
  ledgerEntryId String?
  createdAt     String

  @@index([tenantId, paidAt])
}

model CatalogProduct {
  id           String   @id
  tenantId     String
  categoryId   String
  name         String
  slug         String
  description  String?
  type         String
  basePrice    Float
  currency     String
  imageUrl     String?
  images       String? // JSON: ProductImage[]
  optionGroups String? // JSON: OptionGroup[] (embedded)
  variants     String? // JSON: ProductVariant[]
  stock        Int?
  isAvailable  Boolean
  createdAt    String?
  isFeatured   Boolean?
  isArchived   Boolean? @default(false)
  sortOrder    Int?     @default(0)

  @@index([tenantId])
  @@index([tenantId, categoryId])
}

model CatalogOptionGroup {
  id                 String   @id
  tenantId           String
  name               String
  type               String?
  required           Boolean
  minSelected        Int
  maxSelected        Int
  selectionType      String
  scope              String?
  scopeId            String?
  allowHalfPlacement Boolean?
  items              String? // JSON: OptionItem[]

  @@index([tenantId])
}

// --- Delivery (tenant-scoped) ---
model TenantDeliverySettings {
  tenantId     String  @id
  modes        String? // JSON: { pickup, delivery }
  minimumOrder Float   @default(0)
  deliveryFee  Float   @default(0)
  payload      String? // JSON: extra fields (zones, etc.)
}

model DeliveryZone {
  id           String  @id
  tenantId     String
  name         String
  fee          Float
  etaMinutes   Int?
  minimumOrder Float?
  geo          String? // JSON: polygon/geo for future
  isActive     Boolean @default(true)
  sortOrder    Int?

  @@index([tenantId])
}

// --- Contests & Predictions (pop-up for logged-in customers) ---
model Contest {
  id             String                 @id
  title          String
  description    String?
  type           String // QUESTION | PREDICTION
  options        String? // JSON: [{ id, label }] for choices (not used when isPrediction)
  correctAnswer  String? // QUESTION: option id; PREDICTION: option id or "scoreA-scoreB" for match
  isActive       Boolean                @default(true)
  rewardCode     String?
  bannerImageUrl String?
  teamAName      String? // Match Prediction: Team A name
  teamBName      String? // Match Prediction: Team B name
  isPrediction   Boolean                @default(false) // Match score prediction (teamA vs teamB)
  finalScoreA    Int? // Set after match ends
  finalScoreB    Int?
  expiresAt      String?
  coinsCost      Int                    @default(0)
  createdAt      String
  participations ContestParticipation[]
}

model ContestParticipation {
  id         String  @id
  customerId String
  contestId  String
  contest    Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userAnswer String // Selected option id or "scoreA-scoreB" for match prediction
  scoreA     Int? // Match prediction: user's guess for team A
  scoreB     Int? // Match prediction: user's guess for team B
  isWinner   Boolean @default(false)
  createdAt  String

  @@unique([customerId, contestId])
  @@index([contestId])
  @@index([customerId])
}

// --- Wheel Prizes (Lucky Wheel; admin-managed segments) ---
model WheelPrize {
  id           String  @id
  label        String
  type         String // PERCENT | FIXED | COINS | NO_WIN
  value        Int     @default(0) // percent 1-100, fixed amount, or coins count
  chanceWeight Int     @default(1) // for probability (higher = more likely)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  @@index([isActive])
}

// --- Now Coins (Lucky Wheel; per-customer balance) ---
model CustomerCoin {
  customerPhone String @unique // normalized phone
  balance       Int    @default(0)
  updatedAt     String

  @@index([customerPhone])
}

// --- Coupons (winner / promo codes; validated at checkout) ---
model Coupon {
  id          String  @id
  code        String  @unique // e.g. WIN2024
  type        String // FIXED | PERCENT
  value       Float // amount in currency or percentage 1-100
  tenantId    String? // null = applies to any tenant
  storeId     String? // null = any store; when set, only items from this store qualify
  oneTimeUse  Boolean @default(false)
  winnerPhone String? // when oneTimeUse: only this phone can use it
  usedAt      String? // set when applied to an order
  createdAt   String
  expiresAt   String?

  @@index([code])
  @@index([winnerPhone])
  @@index([storeId])
}

// --- Global Rewards & Activities (Super Admin; storefront lists via GET /rewards) ---
model GlobalReward {
  id          String             @id
  titleAr     String
  titleEn     String
  description String?
  imageUrl    String?
  type        String // COUPON | EVENT | PRIZE | TOURNAMENT
  coinsCost   Int                @default(0)
  stockLimit  Int                @default(0)
  expiryDate  String? // ISO date (YYYY-MM-DD) or full ISO
  isActive    Boolean            @default(true)
  createdAt   String
  updatedAt   String
  redemptions RewardRedemption[]

  @@index([isActive])
  @@index([type])
}

// --- Reward redemptions (customer spends coins; admin completes / cancels) ---
model RewardRedemption {
  id         String       @id
  customerId String
  rewardId   String
  status     String // PENDING | COMPLETED | CANCELLED
  coinsSpent Int          @default(0)
  redeemedAt String // ISO timestamp
  updatedAt  String?
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward     GlobalReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([rewardId])
  @@index([status])
  @@index([redeemedAt])
}
