# JWT secret - MUST match everywhere that signs/verifies JWTs.
JWT_SECRET=nmd-dev-secret-2026

# Port for the mock API server
PORT=5190

# Customer orders dev override: `1` (default) = GET /customer/orders is public and returns 3 static orders (no JWT). Set `0` for real auth + DB-backed list.
# MOCK_CUSTOMER_ORDERS_STATIC_BYPASS=0

# Public base URL for upload responses (e.g. http://147.93.120.244:5190)
# PUBLIC_URL=http://147.93.120.244:5190

# Storage driver: json (default) or db
# STORAGE_DRIVER=json

# PostgreSQL (required when STORAGE_DRIVER=db). Use service name "postgres" and port 5432 inside Docker; use localhost:5433 when running migrate/seed from host.
# DATABASE_URL=postgresql://nmd:nmd@postgres:5432/nmd

# Web Push VAPID keys. Production: set these; same keys for mock-api and any gateway that serves push.
# Generate: node apps/mock-api/scripts/gen-vapid.cjs
# If unset, hardcoded dev keys are used (may cause 403 or unreliable delivery on some devices).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Firebase Admin (FCM push to merchant Android). Set one of:
# - FIREBASE_SERVICE_ACCOUNT_PATH: path to the JSON key file (e.g. full path to downloaded key, or ./firebase-service-account.json)
# - FIREBASE_SERVICE_ACCOUNT_JSON: stringified JSON of the key (e.g. for Docker without mounting a file)
# FIREBASE_SERVICE_ACCOUNT_PATH=
API_KEY=

# --- WhatsApp OTP (Docker: mock-api → whatsapp-service) ---
# Use the Compose service name and internal port (NOT localhost / host IP from inside mock-api).
# WHATSAPP_GATEWAY_URL=http://whatsapp-service:3000
# WHATSAPP_SERVICE_URL=http://whatsapp-service:3000
# USE_LEGACY_WHATSAPP_GATEWAY=1
# WA_API_KEY=must_match_whatsapp_service_WA_API_KEY
# WHATSAPP_HTTP_TIMEOUT_MS=30000

# --- Hyp / Isracard CreditGuard (hosted payment page) ---
# Relay URL from Hyp — MUST match the same environment as your credentials (UAT relay + UAT user/password/terminal; prod relay + prod).
# Wrong pairing (e.g. live credentials + UAT URL) usually yields non-000 XML result or HTTP 401/400.
# Example UAT: https://ppsuat.creditguard.co.il/xpo/Relay
# HYP_RELAY_BASE_URL=https://ppsuat.creditguard.co.il/xpo/Relay
# API user + password from Hyp terminal registration (POST body: user, password, int_in)
# HYP_API_USER=
# HYP_API_PASSWORD=
# Alias support (YaadPay naming): backend also accepts HYP_MERCHANT_ID and HYP_TOKEN.
# HYP_MERCHANT_ID=
# HYP_TOKEN=
# Terminal + merchant id (mid) from Hyp
# HYP_TERMINAL_NUMBER=
# HYP_MID=
# MAC validation on browser return (often same as API password; override if Hyp says otherwise)
# HYP_MAC_PASSWORD=
# Public URL prefix the user’s browser can open for /payments/hyp/return (must match deployed API + nginx /api prefix)
# Example: PUBLIC_API_BASE_URL=https://nmd.marketing/api
# PUBLIC_API_BASE_URL=
# Optional: shared secret for POST /payments/hyp/webhook
# HYP_WEBHOOK_SECRET=
# Production recommendation: disable demo fallback.
# HYP_DEMO_MODE=0

# --- Platform service fee (Phase 1) ---
# Default false: order totals unchanged. Set true only after market/tenant fee config is ready.
# PLATFORM_FEE_ENABLED=false

# --- Google Play reviewer OTP (customer app) ---
# Fixed OTP only for allowlisted phones; not exposed in API devCode. Defaults work if unset.
# GOOGLE_PLAY_REVIEW_PHONES=0500000000
# GOOGLE_PLAY_REVIEW_OTP=123456
