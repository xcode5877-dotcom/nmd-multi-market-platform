# syntax=docker/dockerfile:1
# Build context MUST be the monorepo root (folder with package.json, pnpm-workspace.yaml, apps/, packages/).
#   docker compose build mock-api
#   docker build -f Dockerfile.mock-api .
# (run both from the repository root — same directory as Dockerfile.mock-api)
FROM node:20-alpine

# Prisma/OpenSSL: Alpine has /bin/sh for RUN; openssl + libc6-compat for @prisma/client
RUN apk add --no-cache openssl ca-certificates libc6-compat

# UTF-8 for Arabic and other non-ASCII (avoids ????? in Admin/Storefront)
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

WORKDIR /app

RUN corepack enable pnpm

# Force rebuild when switching to PostgreSQL (set to current date or any value to bust cache)
ARG PRISMA_REBUILD=postgresql
# Copy workspace config and required packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/core ./packages/core
COPY packages/mock ./packages/mock
COPY apps/mock-api ./apps/mock-api

# Install deps, generate Prisma client for container arch, then build
RUN pnpm install --frozen-lockfile && \
    pnpm --filter @nmd/core build && \
    pnpm --filter mock-api exec -- prisma generate && \
    pnpm --filter mock-api build

# Verify dist exists so we fail the build instead of crashing at runtime
RUN test -f /app/apps/mock-api/dist/index.js || (echo "ERROR: dist/index.js not found after build" && exit 1)

WORKDIR /app/apps/mock-api

# Uploads: path must match UPLOADS_DIR and compose volume uploads_data:/app/uploads
RUN mkdir -p /app/uploads /app/uploads/banners && chmod -R 755 /app/uploads

# Override in docker-compose: STORAGE_DRIVER=db + DATABASE_URL for persistent Postgres. Else JSON + DATA_FILE/ORDERS_FILE.
ENV PORT=5190
ENV STORAGE_DRIVER=json
ENV DATA_FILE=/app/data/data.json
ENV ORDERS_FILE=/app/data/orders.json
ENV DATA_DIR=/app/data
ENV MARKET_CONFIG_FILE=/app/data/market-config.json
# Uploads: use /app/uploads (docker-compose mounts uploads_data here; must match UPLOADS_DIR in compose)
ENV UPLOADS_DIR=/app/uploads

EXPOSE 5190

RUN chmod +x /app/apps/mock-api/docker-entrypoint.sh
ENTRYPOINT ["/app/apps/mock-api/docker-entrypoint.sh"]
# Use absolute path so we never depend on CWD (avoids MODULE_NOT_FOUND if entrypoint changes dir)
CMD ["node", "/app/apps/mock-api/dist/index.js"]
