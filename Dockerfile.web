# Multi-stage build: all 4 frontends + Nginx for nmd.marketing
# VITE_PUBLIC_ORIGIN must match production origin (https://nmd.marketing); set via build-arg in docker-compose.

# ——— Stage 1: storefront ———
FROM node:20-alpine AS storefront
WORKDIR /app
RUN corepack enable pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
ARG VITE_PUBLIC_ORIGIN=https://nmd.marketing
ENV VITE_MOCK_API_URL=${VITE_PUBLIC_ORIGIN}/api
RUN pnpm --filter @nmd/core build && \
    pnpm --filter @nmd/ui build && \
    pnpm --filter @nmd/mock build && \
    pnpm --filter storefront run build:docker

# ——— Stage 2: courier ———
FROM node:20-alpine AS courier
WORKDIR /app
RUN corepack enable pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
ARG VITE_PUBLIC_ORIGIN=https://nmd.marketing
ENV VITE_API_BASE_URL=${VITE_PUBLIC_ORIGIN}/api
RUN pnpm --filter @nmd/core build && \
    pnpm --filter @nmd/ui build && \
    pnpm --filter @nmd/mock build && \
    pnpm --filter courier exec -- vite build

# ——— Stage 3: admin (merchant) ———
FROM node:20-alpine AS merchant
WORKDIR /app
RUN corepack enable pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
ARG VITE_PUBLIC_ORIGIN=https://nmd.marketing
ENV VITE_MOCK_API_URL=${VITE_PUBLIC_ORIGIN}/api
ENV VITE_NMD_ADMIN_URL=${VITE_PUBLIC_ORIGIN}/market-admin
ENV VITE_STOREFRONT_URL=${VITE_PUBLIC_ORIGIN}
RUN pnpm --filter @nmd/core build && \
    pnpm --filter @nmd/ui build && \
    pnpm --filter @nmd/mock build && \
    pnpm --filter admin exec -- vite build

# ——— Stage 4: nmd-admin ———
FROM node:20-alpine AS nmd-admin
WORKDIR /app
RUN corepack enable pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
ARG VITE_PUBLIC_ORIGIN=https://nmd.marketing
ENV VITE_MOCK_API_URL=${VITE_PUBLIC_ORIGIN}/api
RUN pnpm --filter @nmd/core build && \
    pnpm --filter @nmd/ui build && \
    pnpm --filter @nmd/mock build && \
    pnpm --filter nmd-admin exec -- vite build

# ——— Final: Nginx with all dists ———
# Admin dists must land as html/<app>/ and html/<app>/assets/ (no double-nesting) for nginx.
# Wipe admin dirs before COPY so the container never serves stale/phantom assets from a cached layer.
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=storefront /app/apps/storefront/dist /usr/share/nginx/html
COPY --from=courier /app/apps/courier/dist /usr/share/nginx/html/courier
RUN rm -rf /usr/share/nginx/html/market-admin /usr/share/nginx/html/merchant
COPY --from=merchant /app/apps/admin/dist /usr/share/nginx/html/merchant
COPY --from=nmd-admin /app/apps/nmd-admin/dist /usr/share/nginx/html/market-admin
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
